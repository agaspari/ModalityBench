# ModalityBench local environment — copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored. `mb` loads it automatically (cwd + parent dirs); real
# environment variables always win over values here.

# Anthropic API key — needed for real-model runs and the exact serialize-bench.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI-compatible providers for cheap live iteration — needs: pip install -e ".[providers]"
# A model named `deepseek-*` / `glm-*` routes to these automatically (see configs/miniwob-deepseek.yaml).
# DEEPSEEK_API_KEY=      # https://platform.deepseek.com/api_keys
# ZHIPUAI_API_KEY=       # GLM — https://open.bigmodel.cn/usercenter/apikeys

# Live MiniWoB++ tasks only — absolute file:// URL to a local MiniWoB++ html dir.
# Needs: pip install -e ".[browser]" && playwright install chromium
# MINIWOB_URL=file:///abs/path/to/miniwob-plusplus/miniwob/html/miniwob/

# Live WebShop tasks only — base URL of a running WebShop Flask server.
# Needs: pip install -e ".[browser]" + WebShop data/index (see configs/webshop-smoke.yaml).
# WEBSHOP_URL=http://127.0.0.1:3000
